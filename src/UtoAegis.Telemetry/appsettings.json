{
  "UtoAegisTelemetry": {
    "CollectorUri": "https://telemetry.example.invalid/v1/records",
    "AuthenticationKeyId": "replace-with-endpoint-key-id",
    "AuthenticationKeyPath": "C:\\ProgramData\\UtoAegisTelemetry\\Policy\\collector.key",
    "StatePath": "C:\\ProgramData\\UtoAegisTelemetry\\State",
    "BatchSize": 128,
    "PollIntervalSeconds": 30,
    "RequestTimeoutSeconds": 30,
    "Sources": [
      {
        "Name": "monitor",
        "SpoolPath": "C:\\ProgramData\\UtoAegis\\SecurityTelemetry"
      },
      {
        "Name": "updater",
        "SpoolPath": "C:\\ProgramData\\UtoAegisUpdater\\SecurityTelemetry"
      },
      {
        "Name": "guard",
        "SpoolPath": "C:\\ProgramData\\UtoAegisGuard\\SecurityTelemetry"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      },
      "SourceName": "UtoAegisTelemetry",
      "LogName": "Application"
    }
  }
}
